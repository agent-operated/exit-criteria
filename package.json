{
  "name": "exit-criteria",
  "version": "0.0.0-development",
  "description": "Replace an AI's done claim with executed acceptance-check results",
  "private": true,
  "type": "module",
  "bin": {
    "exit-criteria": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/unit/*.test.js dist/test/e2e/*.test.js",
    "exit-criteria": "node dist/src/cli.js check"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  }
}
